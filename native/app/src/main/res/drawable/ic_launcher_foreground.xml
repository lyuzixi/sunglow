<?xml version="1.0" encoding="utf-8"?>
<!--
  SUNGLOW 启动器图标前景：与网页版同源的「光谱环 + 圆心」。
  图形口径：v2/scripts/gen-icons.mjs —— 环心半径 0.315S、环宽 0.075S、圆心 0.105S，
  颜色按角度走 品红 → 琥珀 → 电离青 的 sweep 渐变。
  108×108 视口，视觉半径控制在 30 以内（自适应图标安全区）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 光谱环：外圆 R30 / 内圆 R23.6，evenOdd 挖空 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,54 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 M54,54 m-23.6,0 a23.6,23.6 0 1,0 47.2,0 a23.6,23.6 0 1,0 -47.2,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="sweep"
                android:centerX="54"
                android:centerY="54"
                android:startColor="#FFFF4D82"
                android:centerColor="#FFFF9C3F"
                android:endColor="#FF2ED5E8" />
        </aapt:attr>
    </path>

    <!-- 圆心 -->
    <path
        android:pathData="M54,54 m-8.9,0 a8.9,8.9 0 1,0 17.8,0 a8.9,8.9 0 1,0 -17.8,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="sweep"
                android:centerX="54"
                android:centerY="54"
                android:startColor="#FFFF4D82"
                android:centerColor="#FFFF9C3F"
                android:endColor="#FF2ED5E8" />
        </aapt:attr>
    </path>

</vector>
