    <!-- M5 · 关于 -->
    <string name="about_title">关于</string>
    <string name="about_version">霞光档案 1.0.0 · 光谱观测版</string>
    <string name="about_data">数据来源：Open-Meteo 气象与空气质量接口（CC BY 4.0，许可 https://open-meteo.com/en/terms）；底图为高德公开瓦片，© 高德地图。</string>
    <string name="privacy_url">https://sunglow.cloud/privacy.html</string>
    <string name="about_privacy_title">隐私说明</string>
    <string name="privacy_body">定位只用于匹配最近的城市，不会上传或保存坐标轨迹。通知由本机计算与发送，不经过服务器。应用不收集账号、设备标识与使用行为；仅在取数时向 Open-Meteo 发送城市坐标与日期。</string>
    <string name="about_licenses">开源组件：Kotlin、Jetpack Compose、OkHttp、osmdroid、ZXing、AndroidX WorkManager。</string>
    <string name="about_thanks">灵感与算法来自「霞光档案」网页版；实拍照片摄于广州珠江。</string>

