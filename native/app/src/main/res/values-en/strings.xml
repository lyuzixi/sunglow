    <string name="about_title">About</string>
    <string name="about_version">Sunglow 1.0.0 · Spectral edition</string>
    <string name="about_data">Data: Open-Meteo weather and air-quality APIs (CC BY 4.0, license https://open-meteo.com/en/terms). Basemap: AMap public tiles, © AMap.</string>
    <string name="privacy_url">https://sunglow.cloud/privacy.html</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="privacy_body">Location is used only to match the nearest city; no coordinate history is uploaded or stored. Notifications are computed and sent on device. The app collects no account, device identifiers or usage analytics; only city coordinates and the date are sent to Open-Meteo when fetching data.</string>
    <string name="about_licenses">Open source: Kotlin, Jetpack Compose, OkHttp, osmdroid, ZXing, AndroidX WorkManager.</string>
    <string name="about_thanks">Inspired by the Sunglow web edition. The hero photo was taken on the Pearl River, Guangzhou.</string>

